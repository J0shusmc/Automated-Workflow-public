# Copy to .env and fill in. Real environment variables take precedence.

# --- LLM (Claudia) -----------------------------------------------------------
# Leave blank to auto-detect a local server (llama.cpp :8080, Ollama :11434,
# LM Studio :1234, vLLM :8000). For a hosted provider, set the full URL + key.
AUTOMATED_WORKFLOW_LLM_URL=
AUTOMATED_WORKFLOW_LLM_MODEL=
AUTOMATED_WORKFLOW_LLM_API_KEY=

# UI Start/Stop buttons and the "Kill Claudia LLM" node
AUTOMATED_WORKFLOW_LLM_SERVICE=llama-server
AUTOMATED_WORKFLOW_LLM_KILL_PATTERN=llama-server

# 0 = no per-node timeout
AUTOMATED_WORKFLOW_NODE_TIMEOUT_SECONDS=0

# --- Workflows ---------------------------------------------------------------
# SEC EDGAR requires an identifying User-Agent with a contact email.
JEV_SEC_USER_AGENT='YourAppName ENTER_EMAIL_HERE'

# Product folders the Online Sales workflow emails to buyers
# AUTOMATED_WORKFLOW_PRODUCT_ROOT=data/products

# Lightricks LTX-2 checkout for the YouTube Shorts video node
# LTX_ROOT=external/LTX-2
