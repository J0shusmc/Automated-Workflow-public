# IMAP inbox that receives your website's contact-form notifications.
# Gmail: use an App Password, not your account password.
EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=ENTER_EMAIL_HERE
EMAIL_PASSWORD=ENTER_APP_PASSWORD_HERE
EMAIL_FOLDER=INBOX
EMAIL_SEARCH_CRITERIA=UNSEEN
EMAIL_LOOKBACK_HOURS=120
EMAIL_MARK_READ=false
EMAIL_FROM_FILTER=
EMAIL_SUBJECT_FILTER=New Website Contact

# Spam screening
CONTACT_REQUIRE_SCREENING=true
CONTACT_ALLOWED_COUNTRIES=US,PR,VI,GU,AS,MP
BLOCKED_CONTACT_NAMES=
BLOCKED_CONTACT_DOMAINS=
CONTACT_MINIMUM_MESSAGE_LENGTH=20

# Auto-reply (SMTP falls back to EMAIL_USERNAME/EMAIL_PASSWORD if unset)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
CONTACT_RESPONSE_FROM_EMAIL=
CONTACT_RESPONSE_FROM_NAME=Your Business
CONTACT_BUSINESS_NAME=Your Business
# Signature lines, separated by |
CONTACT_SIGNATURE=Your Name|Your Business
