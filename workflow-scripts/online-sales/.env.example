EMAIL_HOST=imap.gmail.com
EMAIL_PORT=993
EMAIL_USERNAME=ENTER_EMAIL_HERE
EMAIL_PASSWORD=ENTER_APP_PASSWORD_HERE
EMAIL_SALES_FOLDER=INBOX
EMAIL_POLL_SECONDS=300
EMAIL_SEARCH_CRITERIA=UNSEEN
EMAIL_LOOKBACK_HOURS=120
EMAIL_MARK_READ=false
EMAIL_TEST_MODE=true
EMAIL_IGNORE_PROCESSED=false
EMAIL_FROM_FILTER=
EMAIL_SUBJECT_FILTER=
BUYER_EMAIL_REGEX=
PRODUCT_REGEX=
ORDER_ID_REGEX=
PAYMENT_REFERENCE_REGEX=
SALES_OUTPUT_PATH=data/sales.jsonl
LATEST_SALE_PATH=data/latest_sale.json
PROCESSED_EMAILS_PATH=data/processed_emails.json
MAIL_READER_LOG_PATH=logs/mail_reader.log

PAYPAL_CLIENT_ID=ENTER_PAYPAL_CLIENT_ID_HERE
PAYPAL_CLIENT_SECRET=ENTER_PAYPAL_CLIENT_SECRET_HERE
PAYPAL_ENV=sandbox
PAYMENT_VERIFY_TEST_MODE=true
PAYMENT_VERIFY_LOOKBACK_DAYS=5
PAYMENT_VERIFY_WINDOW_DAYS=5
PAYMENT_VERIFY_FALLBACK_WINDOW_HOURS=6
PAYMENT_VERIFY_CURRENCY=USD
PRODUCT_PRICE_MAP={"TradingView HTF FVG (tradingview-fvg)":"20.00"}
VERIFIED_SALES_OUTPUT_PATH=data/verified_sales.jsonl
PAYMENT_REVIEW_OUTPUT_PATH=data/payment_review.jsonl
PAYMENT_VERIFIER_LOG_PATH=logs/paypal_verify.log

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ENTER_EMAIL_HERE
SMTP_PASSWORD=ENTER_APP_PASSWORD_HERE
SMTP_FROM=ENTER_EMAIL_HERE
SMTP_USE_TLS=true
FULFILLMENT_TEST_MODE=true
PRODUCT_ROOT_DIR=../../data/products
PRODUCT_FILE_MAP={"TradingView HTF FVG (tradingview-fvg)":"fvg","Key Levels - ES/NQ":"mylevels"}
FULFILLED_SALES_OUTPUT_PATH=data/fulfilled_sales.jsonl
FULFILLMENT_REVIEW_OUTPUT_PATH=data/fulfillment_review.jsonl
FULFILLMENT_LOG_PATH=data/fulfillment_log.jsonl
FILE_MAILER_LOG_PATH=logs/file_mailer.log
